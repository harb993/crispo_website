# The secret the till uses to collect orders. Generate one (the 🎲 button in the POS
# settings makes one) and paste the SAME value into the POS: الإعدادات ← 🌐 الطلب أونلاين.
RELAY_TILL_KEY=

# Port to listen on. Platforms like Render / Railway / Fly set this for you.
PORT=8080

# Where orders are kept between restarts (a JSON file). Mount a volume here.
RELAY_DATA_DIR=./data

# Set to 1 when running behind a reverse proxy (Caddy, nginx, a platform load
# balancer), so rate limiting sees the customer's IP rather than the proxy's.
TRUST_PROXY=0

# Only if the website is hosted somewhere else than the relay (e.g. a CDN): the
# site's origin(s), comma separated, and build the site with VITE_API_BASE set to
# the relay's URL.
ALLOWED_ORIGINS=

# Development only: a pretend till that accepts every order. NEVER in production.
RELAY_DEMO=0
